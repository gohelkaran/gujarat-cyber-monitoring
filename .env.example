# ==============================================================================
# GUJARAT CYBER CRIME SOCIAL MEDIA INTELLIGENCE & EARLY WARNING SYSTEM
# Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env` (or `copy .env.example .env` on Windows)
# 2. Fill in legitimate deployment values.
# 3. NEVER commit .env to version control!
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME="Gujarat Cyber Crime Social Media Intelligence & Early Warning System"
APP_DESCRIPTION="Intelligence monitoring and early warning system for Gujarat Cyber Crime"
APP_VERSION=0.1.0
DEBUG=false

# Networking & Binding
HOST=127.0.0.1
PORT=8080
ALLOWED_HOSTS=["127.0.0.1", "localhost"]

# Security & Cryptography
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_SUPER_SECRET_MIN_32_CHARS_LONG
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# For async: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=cybercrime_app
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_NAME=gujarat_cyber_intel
DB_SCHEMA=public
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Timezone Configuration (Internal timestamps are always UTC)
DEFAULT_TIMEZONE=Asia/Kolkata

# Rate Limiting & Protection
RATE_LIMIT_PER_MINUTE=120
MAX_CONTENT_LENGTH_BYTES=10485760 # 10MB request size limit

# CORS Configuration (Restricted JSON list)
CORS_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080", "http://localhost:8000", "http://127.0.0.1:8000"]
CORS_ALLOW_CREDENTIALS=true

# Security Headers & SSL
ENFORCE_SSL=false # Set to true in staging and production
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Government Audit & Data Governance
DEFAULT_DATA_CLASSIFICATION=RESTRICTED
AUDIT_LOG_RETENTION_DAYS=730 # 2 years retention requirement
AUDIT_LOG_FILE_PATH=logs/security_audit.log

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json # 'json' or 'console'
MASK_SENSITIVE_DATA=true

# ==============================================================================
# Meta / Facebook Official Graph API Configuration
# Legal Guidance: Only provision credentials authorized for official monitoring.
# Tokens can also be securely configured per-source via encrypted database vault.
# ==============================================================================
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v19.0
META_DEFAULT_ACCESS_TOKEN=
INSTAGRAM_DEFAULT_ACCESS_TOKEN=
META_REQUEST_TIMEOUT_SECONDS=10.0
META_MAX_RETRIES=3
META_BACKOFF_FACTOR=1.5
META_RATE_LIMIT_THRESHOLD_PERCENT=85.0

